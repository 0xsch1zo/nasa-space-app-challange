# Copy to `.env` (cp .env.example .env) and adjust. Loaded automatically by
# the backend (server and seed) and by the Vite dev/preview proxy. Variables
# already set in the shell take precedence over this file.

# PostgreSQL 16 running locally (see README: "Wymagania").
# Created by `npm run db:create`: role `astro` / password `astro`, database `astro_health`.
DATABASE_URL=postgres://astro:astro@localhost:5432/astro_health

# HS256 signing secret for JWT sessions. Use a long random value outside development.
JWT_SECRET=change-me-in-production-please
JWT_TTL_MINUTES=480

# Address the API listens on. 127.0.0.1 keeps it local to this machine;
# use 0.0.0.0:8080 to expose it on the network.
BIND_ADDR=127.0.0.1:8080
# Browser origins allowed to call the API directly (the Vite proxy is same-origin).
CORS_ORIGINS=http://localhost:5173
RUST_LOG=info

# Where the Vite dev server (5173) and preview server (3000) forward /api.
VITE_API_PROXY=http://localhost:8080
